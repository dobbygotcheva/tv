#!/usr/bin/env bash
# tv - cast this laptop's screen to a Miracast TV with GNOME Network Displays.
#
# Usage:
#   tv            start casting (default)
#   tv --reset    kill any stuck instance and restart Wi-Fi P2P, then start
#   tv --stop     stop the app
#   tv --logs     start with debug logs (saved to /tmp/tv-debug.log)
#   tv --help

set -u

APP_ID="org.gnome.NetworkDisplays"

# Make Flatpak's export dirs visible (silences the XDG_DATA_DIRS warning).
export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m  %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m  %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; }

is_running() {
    flatpak ps --columns=application 2>/dev/null | grep -qx "$APP_ID"
}

stop_app() {
    if is_running; then
        info "Stopping running instance..."
        flatpak kill "$APP_ID" 2>/dev/null
        for _ in 1 2 3 4 5; do
            is_running || return 0
            sleep 1
        done
        warn "Instance did not exit cleanly."
    fi
}

ensure_flatpak() {
    command -v flatpak >/dev/null || die "flatpak is not installed. Run: sudo apt install flatpak"

    if ! flatpak remotes 2>/dev/null | grep -q '^flathub'; then
        info "Adding Flathub remote (user)..."
        flatpak remote-add --user --if-not-exists flathub \
            https://dl.flathub.org/repo/flathub.flatpakrepo || die "Could not add Flathub."
    fi

    if ! flatpak info "$APP_ID" >/dev/null 2>&1; then
        info "Installing $APP_ID (one-time)..."
        flatpak install --user -y flathub "$APP_ID" || die "Install failed."
    fi
}

ensure_wifi() {
    command -v nmcli >/dev/null || return 0

    if [ "$(nmcli radio wifi 2>/dev/null)" != "enabled" ]; then
        info "Wi-Fi is off, turning it on..."
        nmcli radio wifi on
        sleep 3
    fi

    if command -v rfkill >/dev/null && rfkill list wifi 2>/dev/null | grep -q 'Hard blocked: yes'; then
        warn "Wi-Fi is hard-blocked (physical switch / Fn key). Unblock it and retry."
    fi

    if ! nmcli -t -f TYPE device 2>/dev/null | grep -qx 'wifi-p2p'; then
        warn "No Wi-Fi P2P device found; your Wi-Fi card may not support Miracast."
    fi
}

reset_p2p() {
    info "Resetting Wi-Fi P2P state..."
    stop_app
    # Drop any leftover P2P group interfaces from a previous session.
    nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi-p2p"{print $1}' | while read -r dev; do
        nmcli device disconnect "$dev" >/dev/null 2>&1 || true
    done
    sleep 2
}

start_app() {
    cat <<'EOF'

  On the TV: open "Screen Share" / "Miracast" and keep that screen open.
  In the app: pick your TV from the list and wait a few seconds.
  Close the app window (or press Ctrl+C here) to stop casting.

EOF
    info "Starting GNOME Network Displays..."
    if [ "${DEBUG:-0}" = "1" ]; then
        info "Debug log: /tmp/tv-debug.log"
        flatpak run --env=G_MESSAGES_DEBUG=all --env=GST_DEBUG=3 "$APP_ID" 2>&1 | tee /tmp/tv-debug.log
    else
        flatpak run "$APP_ID"
    fi
}

DEBUG=0
RESET=0

case "${1:-}" in
    -h|--help)  usage; exit 0 ;;
    --stop)     stop_app; info "Stopped."; exit 0 ;;
    --reset)    RESET=1 ;;
    --logs)     DEBUG=1 ;;
    "")         ;;
    *)          usage; exit 1 ;;
esac

ensure_flatpak
ensure_wifi

if [ "$RESET" = "1" ]; then
    reset_p2p
elif is_running; then
    warn "App is already running - bringing it to the front."
    warn "If nothing appears, run: tv --reset"
fi

# Clean up the app if the user hits Ctrl+C in the terminal.
trap 'echo; stop_app; exit 130' INT TERM

start_app
